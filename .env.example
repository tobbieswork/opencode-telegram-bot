# --- Telegram ---------------------------------------------------------------
# Get a bot token from @BotFather (send /newbot).
TELEGRAM_BOT_TOKEN=123456:ABC-DEF0_ghij_klMN
# Comma-separated NUMERIC Telegram user IDs allowed to use the bot.
# Find yours by messaging @userinfobot. REQUIRED unless OPENCODE_TG_ALLOW_ANY=1.
TELEGRAM_ALLOWED_USER_IDS=123456789
# Set to 1 to allow ANYONE. NOT recommended - this runs code on your machine.
# OPENCODE_TG_ALLOW_ANY=1

# --- OpenCode ----------------------------------------------------------------
# Working directory for new sessions (default: where you run the bot).
# OPENCODE_DIRECTORY=/home/phatnd12/fpt
# Connect to a specific OpenCode service instead of auto-discovering:
# OPENCODE_SERVICE_URL=http://127.0.0.1:4096
# OPENCODE_SERVICE_USER=opencode
# OPENCODE_SERVICE_PASSWORD=change-me
# Optional defaults for new sessions:
# OPENCODE_DEFAULT_AGENT=build
# OPENCODE_DEFAULT_MODEL_ID=anthropic/claude-sonnet-4-5
# OPENCODE_DEFAULT_MODEL_PROVIDER=anthropic
# Default reasoning variant applied to each new session (e.g. xhigh, high, medium, low).
# Change per-session with /variants.
# OPENCODE_DEFAULT_VARIANT=xhigh
#
# --- Questions -----------------------------------------------------------------
# The agent's `question` tool is relayed to Telegram as buttons (one question at
# a time). Set to 0 to stop prepending the "ask via question tool" note to new
# sessions.
# OPENCODE_TG_GUIDE=1
# Directories the /browse folder browser may walk (comma-separated; default: home).
# OPENCODE_TG_BROWSE_ROOTS=/home/phatnd12,/home/phatnd12/fpt

# --- Misc --------------------------------------------------------------------
# STATE_FILE=./data/state.json
# TELEGRAM_REPLY_MAX_LEN=4000
