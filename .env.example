# --- Telegram ---------------------------------------------------------------
# Get a bot token from @BotFather (send /newbot).
TELEGRAM_BOT_TOKEN=123456:ABC-DEF0_ghij_klMN
# Comma-separated NUMERIC Telegram user IDs allowed to use the bot.
# Find yours by messaging @userinfobot. REQUIRED unless OPENCODE_TG_ALLOW_ANY=1.
TELEGRAM_ALLOWED_USER_IDS=123456789
# Set to 1 to allow ANYONE. NOT recommended - this runs code on your machine.
# OPENCODE_TG_ALLOW_ANY=1

# --- OpenCode ----------------------------------------------------------------
# Working directory for new sessions (default: where you run the bot).
# OPENCODE_DIRECTORY=/home/phatnd12/fpt
# Connect to a specific OpenCode service instead of auto-discovering:
# OPENCODE_SERVICE_URL=http://127.0.0.1:4096
# OPENCODE_SERVICE_USER=opencode
# OPENCODE_SERVICE_PASSWORD=change-me
# Optional defaults for new sessions:
# OPENCODE_DEFAULT_AGENT=build
# OPENCODE_DEFAULT_MODEL_ID=anthropic/claude-sonnet-4-5
# OPENCODE_DEFAULT_MODEL_PROVIDER=anthropic
# Default reasoning variant applied to each new session (e.g. xhigh, high, medium, low).
# Change per-session with /variants.
# OPENCODE_DEFAULT_VARIANT=xhigh
#
# --- Questions -----------------------------------------------------------------
# The agent's `question` tool is relayed to Telegram as buttons (one question at
# a time). Set to 0 to stop prepending the "ask via question tool" note to new
# sessions.
# OPENCODE_TG_GUIDE=1
# Keep replies in the language the user wrote in (a per-session instruction; set 0 to
# turn it off — it is also removed from sessions that already have it).
# OPENCODE_TG_LANGUAGE=1
# Show a live "agent is doing…" line (📖 Đang đọc src/…, ▶ Đang chạy npm test…)
# while a turn runs. Set to 0 to hide it.
# OPENCODE_TG_ACTIVITY=1
# Re-send an unanswered question/permission with exponential backoff (gaps of
# base, base*factor, base*factor^2, …). The prompt itself stays pending afterwards.
# OPENCODE_TG_REMIND=1
# OPENCODE_TG_REMIND_BASE_MS=300000
# OPENCODE_TG_REMIND_FACTOR=2
# OPENCODE_TG_REMIND_MAX=4
# Directories the /browse folder browser may walk (comma-separated; default: home).
# OPENCODE_TG_BROWSE_ROOTS=/home/phatnd12,/home/phatnd12/fpt

# --- Multi-session: worker topics + Manager agent --------------------------------
# Workers run in forum topics (a private chat with topic mode, or a forum
# supergroup where the bot is admin with "Manage topics"). Workers may only run
# under OPENCODE_TG_BROWSE_ROOTS.
# Max workers per chat that may be busy at the same time.
# OPENCODE_TG_MAX_WORKERS=5
# Git worktree isolation for workers that edit files:
#   auto   = only when another writing worker already uses the same repo (default)
#   always = every writing worker in a git repo gets its own worktree + branch
#   off    = never
# OPENCODE_TG_WORKTREE=auto
# Where each chat's Manager session lives (holds its agent definition).
# OPENCODE_TG_MANAGER_DIR=./data/manager
# Port of the Manager's local tool bridge (MCP, bound to 127.0.0.1; 0 = random).
# OPENCODE_TG_BRIDGE_PORT=0

# --- Misc --------------------------------------------------------------------
# STATE_FILE=./data/state.json
# TELEGRAM_REPLY_MAX_LEN=4000

# --- Worker overflow recovery -------------------------------------------------
# Auto-respawn a worker whose session died from context overflow (one respawn
# per task, same directory). OFF by default: it spends tokens and runs a write
# agent unattended. Set to 1 to enable.
# OPENCODE_TG_RECOVER_OVERFLOW=1
# --- DNS self-heal (VPN) -----------------------------------------------------
# After repeated Telegram `fetch failed` errors, restart systemd-resolved — but
# ONLY when `resolvectl status` still lists this stale VPN DNS server. Leave
# unset to keep the heal off. Needs a NOPASSWD sudoers rule for exactly
# `systemctl restart systemd-resolved`.
# OPENCODE_TG_DNS_STALE_IP=
# OPENCODE_TG_DNS_HEAL=1
