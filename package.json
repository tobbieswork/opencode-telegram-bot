{
  "name": "opencode-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remotely control a running OpenCode service from Telegram",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:format": "tsx scripts/test-format.ts",
    "test:fsbrowser": "tsx scripts/test-fsbrowser.ts",
    "test:state": "tsx scripts/test-state.ts",
    "test:activity": "tsx scripts/test-activity.ts",
    "test:reminders": "tsx scripts/test-reminders.ts",
    "test:continue": "tsx scripts/test-continue.ts",
    "test:prune": "tsx scripts/test-prune.ts",
    "test:config": "tsx scripts/test-config.ts",
    "test:dns-heal": "tsx scripts/test-dns-heal.ts",
    "test:rich": "tsx scripts/test-rich-replies.ts",
    "test:unit": "npm run test:format && npm run test:fsbrowser && npm run test:state && npm run test:multi && npm run test:activity && npm run test:reminders && npm run test:prune && npm run test:config && npm run test:rich && npm run test:continue && npm run test:dns-heal",
    "typecheck": "tsc --noEmit",
    "test:multi": "tsx scripts/test-multi.ts",
    "smoke:multi": "tsx scripts/smoke-multi.ts"
  },
  "dependencies": {
    "@opencode/client": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
