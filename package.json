    "smoke": "tsx scripts/smoke.ts",
    "test:format": "tsx scripts/test-format.ts",
    "test:fsbrowser": "tsx scripts/test-fsbrowser.ts",
    "test:state": "tsx scripts/test-state.ts",
    "test:activity": "tsx scripts/test-activity.ts",
    "test:reminders": "tsx scripts/test-reminders.ts",
    "test:schedule": "tsx scripts/test-schedule.ts",
    "test:node": "tsx scripts/test-node.ts",
    "test:scheduler": "tsx scripts/test-scheduler.ts",
    "test:continue": "tsx scripts/test-continue.ts",
    "test:prune": "tsx scripts/test-prune.ts",
    "test:config": "tsx scripts/test-config.ts",
    "test:uptime": "tsx scripts/test-uptime.ts",
    "test:notes": "tsx scripts/test-notes.ts",
    "test:notes-callback": "tsx scripts/test-notes-callback.ts",
    "test:usage": "tsx scripts/test-usage.ts",
    "test:recovery": "tsx scripts/test-recovery.ts",
    "test:topic-delete": "tsx scripts/test-topic-delete.ts",
    "test:dns-heal": "tsx scripts/test-dns-heal.ts",
    "test:rich": "tsx scripts/test-rich-replies.ts",
    "test:stream": "tsx scripts/test-stream.ts",
    "test:pr-watch": "tsx scripts/test-pr-watch.ts",
    "test:commands": "tsx scripts/test-commands.ts",
    "test:reactions": "tsx scripts/test-reactions.ts",
    "test:unit": "npm run test:format && npm run test:fsbrowser && npm run test:state && npm run test:multi && npm run test:activity && npm run test:reminders && npm run test:schedule && npm run test:node && npm run test:scheduler && npm run test:prune && npm run test:config && npm run test:rich && npm run test:stream && npm run test:continue && npm run test:dns-heal && npm run test:recovery && npm run test:topic-delete && npm run test:uptime && npm run test:usage && npm run test:notes && npm run test:notes-callback && npm run test:pr-watch && npm run test:reactions && npm run test:commands",
    "typecheck": "tsc --noEmit",
    "test:multi": "tsx scripts/test-multi.ts",
    "smoke:multi": "tsx scripts/smoke-multi.ts"
  },
  "dependencies": {
    "@opencode/client": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
